{{- $githubUsername := "" -}}
{{- if .work.enable -}}
{{- if and (hasKey . "github") (hasKey .github "workUsername") -}}
{{- $githubUsername = get .github "workUsername" -}}
{{- else if and (hasKey . "work") (hasKey .work "git") (hasKey .work.git "username") -}}
{{- $githubUsername = get .work.git "username" -}}
{{- else if and (hasKey . "github") (hasKey .github "username") -}}
{{- $githubUsername = get .github "username" -}}
{{- end -}}
{{- else if and (hasKey . "github") (hasKey .github "username") -}}
{{- $githubUsername = get .github "username" -}}
{{- else if and (hasKey . "personal") (hasKey .personal "git") (hasKey .personal.git "username") -}}
{{- $githubUsername = get .personal.git "username" -}}
{{- end -}}
{{- $ghProfile := "personal" -}}
{{- if .work.enable -}}{{- $ghProfile = "work" -}}{{- end -}}
{{- $ghTokenConfigDir := printf "~/.config/gh-%s" $ghProfile -}}
{{- if and (hasKey . "github") (hasKey .github "configDir") -}}
{{- $ghConfig := get .github "configDir" -}}
{{- if hasKey $ghConfig $ghProfile -}}{{- $ghTokenConfigDir = get $ghConfig $ghProfile -}}{{- end -}}
{{- end -}}

# Debug startup time
#zmodload zsh/zprof
#setopt prompt_subst; zmodload zsh/datetime; PS4='+[$EPOCHREALTIME]%N:%i> ';
#set -x

# Atuin owns history storage. Keep zsh from writing a second, unfiltered history file.
HISTFILE=/dev/null
SAVEHIST=

if [ -d "$BREW_HOME/share/zsh-completions" ]; then
  FPATH="$BREW_HOME/share/zsh-completions:$FPATH"
fi

export GPG_TTY=$(tty)
# export GPG_TTY=$TTY # redundant; GPG_TTY=$(tty) already set
export PATH="$BREW_HOME/bin:$PATH"
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"

if command -v brew >/dev/null; then
  eval "$(brew shellenv)"
fi
if command -v mise >/dev/null; then
  eval "$(mise activate zsh)"
fi

# Discover managed tools before loading credentials. gh reads the local store;
# it does not call GitHub's API. Keep this in interactive, non-login shells too.
if [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  _gh_config_dir="${GH_CONFIG_DIR:-{{ $ghTokenConfigDir }}}"
  case "$_gh_config_dir" in
    "~") _gh_config_dir="$HOME" ;;
    "~/"*) _gh_config_dir="$HOME/${_gh_config_dir#'~/'}" ;;
  esac
  _mise_github_token=$(GH_CONFIG_DIR="$_gh_config_dir" gh auth token 2>/dev/null || true)
  if [[ -n "$_mise_github_token" ]]; then
    export GITHUB_TOKEN="$_mise_github_token"
  fi
  unset _mise_github_token _gh_config_dir
fi
{{- if ne $githubUsername "" }}
if [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]] && command -v security >/dev/null 2>&1; then
  _mise_github_token=$(security find-generic-password -s "github" -a {{ $githubUsername | quote }} -w 2>/dev/null || true)
  if [[ -n "$_mise_github_token" ]]; then
    export GITHUB_TOKEN="$_mise_github_token"
  fi
  unset _mise_github_token
fi
{{- end }}

if command -v zoxide >/dev/null; then
  eval "$(zoxide init zsh)"
fi
if command -v starship >/dev/null; then
  eval "$(starship init zsh)"
fi
if (( $+commands[thefuck] )); then
  # Load the Python-backed alias only when it is actually used.
  fuck() {
    unfunction fuck
    # Python 3.12+ removed distutils; older thefuck builds can crash on import.
    if ! thefuck --version >/dev/null 2>&1; then
      return 127
    fi
    eval "$(thefuck --alias fuck)" || return
    fuck "$@"
  }
fi

# The following lines have been added by Docker Desktop to enable Docker CLI completions.
fpath=($HOME/.docker/completions $fpath)
if [[ -d "$HOME/.config/zsh/completions" ]]; then
  fpath=("$HOME/.config/zsh/completions" $fpath)
fi
autoload -Uz compinit compaudit
# Trust the checked fpath and reuse the dump; remove ~/.zcompdump after changing completion paths.
if (( ${#$(compaudit)} == 0 )); then
  compinit -C
else
  compinit
fi
if command -v wt >/dev/null 2>&1; then
  eval "$(wt config shell init zsh)"
fi
# End of Docker CLI completions

[ -f ~/.config/zsh/aliases.zsh ] && source ~/.config/zsh/aliases.zsh
[ -f ~/.config/zsh/daily.zsh ] && source ~/.config/zsh/daily.zsh # Run expensive operations once per day
[ -f ~/.config/zsh/completions.zsh ] && source ~/.config/zsh/completions.zsh
if [ -f "$BREW_HOME/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]; then
  source "$BREW_HOME/share/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

if command -v atuin >/dev/null; then
  eval "$(atuin init zsh)"
fi
if [ -r "$BREW_HOME/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]; then
  source "$BREW_HOME/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
