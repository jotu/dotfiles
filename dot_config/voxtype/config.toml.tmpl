{{- if eq .chezmoi.os "darwin" }}
# Managed macOS Voxtype defaults. Model files stay outside Chezmoi.
engine = "whisper"

[hotkey]
# AeroSpace handles Ctrl+§; disable Voxtype's standalone modifier hotkey.
enabled = false

[whisper]
model = "small.en"
language = "en"

[output]
mode = "type"
fallback_to_clipboard = true
{{- end }}
