# Match Pi's Catppuccin Macchiato theme on macOS and Omarchy's active theme on Linux.
[appearance]
theme = "{{ if eq .chezmoi.os "linux" }}omarchy{{ else }}catppuccin_macchiato{{ end }}"

# Start each new TUIOS session tiled so split bindings work immediately.
[startup]
tiled = true

# Match the non-US keyboard while preserving Option-generated characters.
[keybindings]
keyboard_layout = "other"
option_glyphs = "auto"
