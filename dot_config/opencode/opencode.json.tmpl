{{- $profile := "home-copilot" -}}
{{- if and (hasKey . "opencode") (hasKey .opencode "profile") .opencode.profile -}}
  {{- $profile = .opencode.profile -}}
{{- else if .work.enable -}}
  {{- $profile = "work-openai" -}}
{{- end -}}
{{- $copilotPalette := "balanced" -}}
{{- if eq $profile "home-copilot" -}}
  {{- $copilotPalette = "quality" -}}
{{- end -}}
{{- if and (eq $profile "work-copilot") (hasKey . "opencode") (hasKey .opencode "workModelPalette") .opencode.workModelPalette -}}
  {{- $copilotPalette = .opencode.workModelPalette -}}
{{- else if and (hasKey . "opencode") (hasKey .opencode "modelPalette") .opencode.modelPalette -}}
  {{- $copilotPalette = .opencode.modelPalette -}}
{{- end -}}
{{- $copilotFlagship := "github-copilot/gpt-5.6-luna" -}}
{{- $copilotCoding := "github-copilot/gpt-5.3-codex" -}}
{{- $copilotHelper := "github-copilot/gpt-5-mini" -}}
{{- if eq $copilotPalette "quality" -}}
  {{- $copilotFlagship = "github-copilot/gpt-5.6-terra" -}}
  {{- $copilotCoding = "github-copilot/gpt-5.3-codex" -}}
  {{- $copilotHelper = "github-copilot/gpt-5.4-mini" -}}
{{- else if ne $copilotPalette "balanced" -}}
  {{- fail (printf "unsupported opencode modelPalette: %s" $copilotPalette) }}
{{- end -}}
{
  "permission": {{ includeTemplate ".chezmoitemplates/opencode/permission.json.tmpl" }},
{{- if eq $profile "work-openai" }}
