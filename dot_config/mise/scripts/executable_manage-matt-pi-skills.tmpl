#!/usr/bin/env bash
# Install missing or refresh selected stable Matt Pocock skills in the shared catalog.
set -euo pipefail

: "${HOME:?HOME is required}"

# Advance this immutable upstream ref only after reviewing its skill changes.
matt_skills_ref='49dd158d1076134a641b33efb035946536778336'
source_repo="https://github.com/mattpocock/skills/tree/$matt_skills_ref"
skills_cli=(npx --yes skills@1.7.6)
skills_dir="$HOME/.agents/skills"
managed_matt_skills=''

if ! command -v pi >/dev/null 2>&1; then
  printf 'Skipping Matt skills: pi is not installed.\n' >&2
  exit 0
fi

# Stable catalog only: skills/engineering and skills/productivity.
matt_skills=(
  ask-matt
  code-review
  codebase-design
  diagnosing-bugs
  domain-modeling
  grill-with-docs
  implement
  implement-spec
  improve-codebase-architecture
{{ if not .work.enable }}
  # Personal-only: work setups use their own PR skill.
  pr
{{ end }}
  prototype
  research
  retro
  setup-matt-pocock-skills
  tdd
  to-spec
  to-tickets
  triage
  wayfinder
  wizard
  grill-me
  grilling
  handoff
  teach
  to-questionnaire
  wait-what
  writing-for-agents
)

load_managed_matt_skills() {
  local json
  command -v npx >/dev/null 2>&1 || { printf 'ERROR: npx is required to inspect Matt skills\n' >&2; return 1; }
  command -v node >/dev/null 2>&1 || { printf 'ERROR: node is required to inspect Matt skills\n' >&2; return 1; }
  if ! json=$("${skills_cli[@]}" list --global --agent pi --json 2>/dev/null); then
    printf 'ERROR: unable to inspect globally installed Pi skills\n' >&2
    return 1
  fi
  if ! managed_matt_skills=$(printf '%s' "$json" | node -e '
    const fs = require("fs");
    const skills = JSON.parse(fs.readFileSync(0, "utf8"));
    if (!Array.isArray(skills)) throw new Error("Expected a skills array");
    const states = new Map();
    function isMattSource(value) {
      if (value === "mattpocock/skills") return true;
      try {
        const url = new URL(value);
        return url.protocol === "https:" && url.hostname === "github.com" &&
          /^\/mattpocock\/skills(?:\.git|\/tree\/[0-9a-f]{40})?\/?$/i.test(url.pathname);
      } catch { return false; }
    }
    for (const skill of skills) {
      if (!skill || typeof skill.name !== "string") continue;
      const sources = [skill.source, skill.sourceUrl].filter(Boolean);
      const verified = sources.length > 0 && sources.every(isMattSource);
      states.set(skill.name, (states.get(skill.name) ?? true) && verified);
    }
    for (const [name, verified] of states) console.log(`${verified ? "managed" : "occupied"}:${name}`);
  '); then
    printf 'ERROR: unable to parse globally installed Pi skills\n' >&2
    return 1
  fi
}

is_managed_matt_skill() {
  case $'\n'"$managed_matt_skills"$'\n' in
    *$'\n'"managed:$1"$'\n'*) return 0 ;;
    *) return 1 ;;
  esac
}

is_occupied_skill() {
  case $'\n'"$managed_matt_skills"$'\n' in
    *$'\n'"occupied:$1"$'\n'*) return 0 ;;
  esac
  [ -e "$skills_dir/$1" ] || [ -L "$skills_dir/$1" ]
}

check_skills() {
  load_managed_matt_skills
  local skill state
  for skill in "${matt_skills[@]}"; do
    if is_managed_matt_skill "$skill"; then
      state=installed
    elif is_occupied_skill "$skill"; then
      state=conflict
    else
      state=missing
    fi
    printf '%-35s %s\n' "$skill" "$state"
  done
}

refresh_pi_skills() {
  local -a skills=("$@")
  printf 'Updating installed skills: %s\n' "${skills[*]}"
  # `skills update` has no agent filter; use an explicit Pi target instead.
  "${skills_cli[@]}" add "$source_repo" --skill "${skills[@]}" --agent pi --global --yes
}

install_skills() {
  command -v npx >/dev/null 2>&1 || { printf 'ERROR: npx is required to install or update Matt skills\n' >&2; return 1; }
  load_managed_matt_skills
  local skill update_existing=false
  local -a missing_skills=() refresh_skills=()
  if [ "${MISE_INSTALLED_TOOLS:-[]}" != '[]' ]; then
    update_existing=true
  fi
  for skill in "${matt_skills[@]}"; do
    if is_managed_matt_skill "$skill"; then
      if [ "$update_existing" = true ]; then
        refresh_skills+=("$skill")
      else
        printf 'Keeping installed skill: %s\n' "$skill"
      fi
    elif is_occupied_skill "$skill"; then
      printf 'Skipping occupied shared skill: %s\n' "$skill" >&2
    else
      missing_skills+=("$skill")
    fi
  done

  if ((${#missing_skills[@]} > 0)); then
    printf 'Installing missing skills: %s\n' "${missing_skills[*]}"
    "${skills_cli[@]}" add "$source_repo" --skill "${missing_skills[@]}" --agent pi --global --yes
  fi
  if ((${#refresh_skills[@]} > 0)); then
    refresh_pi_skills "${refresh_skills[@]}"
  fi
}

update_skills() {
  command -v npx >/dev/null 2>&1 || { printf 'ERROR: npx is required to update Matt skills\n' >&2; return 1; }
  load_managed_matt_skills
  local skill
  local -a refresh_skills=()
  for skill in "${matt_skills[@]}"; do
    if ! is_managed_matt_skill "$skill"; then
      printf 'Skipping missing or unverified skill: %s\n' "$skill"
    else
      refresh_skills+=("$skill")
    fi
  done
  if ((${#refresh_skills[@]} > 0)); then
    refresh_pi_skills "${refresh_skills[@]}"
  fi
}

case "${1:-}" in
  check) check_skills ;;
  install) install_skills ;;
  update) update_skills ;;
  *)
    printf 'Usage: %s {check|install|update}\n' "$0" >&2
    exit 2
    ;;
esac
