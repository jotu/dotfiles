#!/usr/bin/env bash
# Sync Pi's bundled sub-agent extension after Pi installs or updates.
set -euo pipefail

: "${HOME:?HOME is required}"

target_dir="$HOME/.pi/agent/extensions/subagent"

find_source_dir() {
  local candidate_root pi_bin resolved_pi_bin

  find_in_root() {
    candidate_root="$1"
    if [ -d "$candidate_root/examples/extensions/subagent" ]; then
      printf '%s\n' "$candidate_root/examples/extensions/subagent"
      return 0
    fi
    if [ -d "$candidate_root/lib/node_modules/@earendil-works/pi-coding-agent/examples/extensions/subagent" ]; then
      printf '%s\n' "$candidate_root/lib/node_modules/@earendil-works/pi-coding-agent/examples/extensions/subagent"
      return 0
    fi
    return 1
  }

  if [ -n "${MISE_TOOL_INSTALL_PATH:-}" ]; then
    find_in_root "$MISE_TOOL_INSTALL_PATH"
    return $?
  fi

  if command -v mise >/dev/null 2>&1; then
    candidate_root=$(mise where npm:@earendil-works/pi-coding-agent 2>/dev/null || true)
    if [ -n "$candidate_root" ] && find_in_root "$candidate_root"; then
      return 0
    fi
  fi

  if ! command -v pi >/dev/null 2>&1; then
    return 1
  fi
  pi_bin=$(command -v pi)
  if command -v realpath >/dev/null 2>&1; then
    resolved_pi_bin=$(realpath "$pi_bin" 2>/dev/null || printf '%s' "$pi_bin")
  elif resolved_pi_bin=$(readlink -f "$pi_bin" 2>/dev/null); then
    :
  else
    resolved_pi_bin="$pi_bin"
  fi
  for candidate_root in "$(dirname "$resolved_pi_bin")" "$(cd "$(dirname "$resolved_pi_bin")/.." && pwd)" "$(cd "$(dirname "$resolved_pi_bin")/../.." && pwd)"; do
    if find_in_root "$candidate_root"; then
      return 0
    fi
  done

  return 1
}

if ! source_dir=$(find_source_dir); then
  if [ -n "${MISE_TOOL_INSTALL_PATH:-}" ]; then
    printf 'Pi sub-agent extension source not found in the explicit Mise install path: %s\n' "$MISE_TOOL_INSTALL_PATH" >&2
    exit 1
  fi
  printf 'Pi sub-agent extension source not found; skipping sync.\n' >&2
  exit 0
fi

# Reject incomplete sources before removing the installed extension.
for source_file in index.ts agents.ts; do
  if [ ! -f "$source_dir/$source_file" ] || [ ! -r "$source_dir/$source_file" ]; then
    printf 'Pi subagent source is missing or unreadable: %s\n' "$source_dir/$source_file" >&2
    exit 1
  fi
done

# Pi scans one level of subdirectories; stage the extension one level deeper.
mkdir -p "$(dirname "$target_dir")"
staging_dir=$(mktemp -d "$(dirname "$target_dir")/.subagent-sync.XXXXXXXX")
trap 'rm -rf "$staging_dir"' EXIT
mkdir -m 700 "$staging_dir/subagent"
# Keep the bundled tree together if upstream adds local dependencies.
cp -R "$source_dir/." "$staging_dir/subagent/"
rm -rf "$target_dir"
mv "$staging_dir/subagent" "$target_dir"
