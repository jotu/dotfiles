#!/usr/bin/env bash
# Remove only selected Addy skills and references previously managed for Pi.
set -euo pipefail

: "${HOME:?HOME is required}"

skills_cli=(npx --yes skills@1.7.0)
addy_skills_ref='aeac41d4d005999432bb7312f7ff06383a91d59d'

# Keep the migration scoped to the exact skill allowlist this repo installed.
addy_skills=(
	api-and-interface-design
	frontend-ui-engineering
	observability-and-instrumentation
	security-and-hardening
	browser-testing-with-devtools
	ci-cd-and-automation
	code-simplification
	deprecation-and-migration
	documentation-and-adrs
	doubt-driven-development
	performance-optimization
	shipping-and-launch
	source-driven-development
)

reference_files=(
	accessibility-checklist.md
	definition-of-done.md
	observability-checklist.md
	orchestration-patterns.md
	performance-checklist.md
	security-checklist.md
)

run_skills_cli() {
	DO_NOT_TRACK=1 NPM_CONFIG_OFFLINE=true "${skills_cli[@]}" "$@"
}

load_managed_addy_skills() {
	local json skill_list
	command -v npx >/dev/null 2>&1 || {
		printf 'ERROR: npx is required to verify managed Addy skills\n' >&2
		return 1
	}
	command -v node >/dev/null 2>&1 || {
		printf 'ERROR: node is required to verify managed Addy skills\n' >&2
		return 1
	}
	if ! json=$(run_skills_cli list --global --agent pi --json 2>/dev/null); then
		printf 'ERROR: unable to inspect globally installed Pi skills; no cleanup was performed\n' >&2
		return 1
	fi
	if ! skill_list=$(printf '%s' "$json" | node -e '
const fs = require("node:fs");
const allowed = new Set(process.argv.slice(1));
const skills = JSON.parse(fs.readFileSync(0, "utf8"));
if (!Array.isArray(skills)) throw new Error("Expected a skills array");
function isOfficialSource(candidate) {
  if (candidate === "addyosmani/agent-skills") return true;
  if (!candidate || !candidate.startsWith("https://")) return false;
  try {
    const url = new URL(candidate);
    const path = url.pathname.replace(/\.git$/, "").replace(/\/+$/, "");
    return url.hostname === "github.com" && (
      path === "/addyosmani/agent-skills" ||
      /^\/addyosmani\/agent-skills\/tree\/[0-9a-f]{40}$/i.test(path)
    );
  } catch {
    return false;
  }
}
function isManagedSource(skill) {
  const candidates = [skill.source, skill.sourceUrl].filter(Boolean);
  return candidates.length > 0 && candidates.every(isOfficialSource);
}
const sourcesByName = new Map();
for (const skill of skills) {
  if (!skill || typeof skill.name !== "string" || !allowed.has(skill.name)) continue;
  const state = sourcesByName.get(skill.name) || { found: false, foreignSource: false };
  state.found = true;
  if (!isManagedSource(skill)) state.foreignSource = true;
  sourcesByName.set(skill.name, state);
}
for (const [name, state] of sourcesByName) {
  if (state.found && !state.foreignSource) console.log(name);
}
' "${addy_skills[@]}"); then
		printf 'ERROR: unable to parse installed Pi skill ownership; no cleanup was performed\n' >&2
		return 1
	fi
	managed_addy_skills="$skill_list"
}

remove_addy_skills() {
	load_managed_addy_skills
	local skill
	local -a selected_skills=()
	while IFS= read -r skill; do
		[ -n "$skill" ] && selected_skills+=("$skill")
	done <<<"$managed_addy_skills"

	if ((${#selected_skills[@]} == 0)); then
		printf 'No managed Addy Pi skills found.\n'
		return 0
	fi

	printf 'Removing verified Addy Pi skills: %s\n' "${selected_skills[*]}"
	if ! run_skills_cli remove "${selected_skills[@]}" --global --agent pi --yes; then
		printf 'ERROR: Pi skill removal failed; shared references were left unchanged\n' >&2
		return 1
	fi
}

remove_addy_references() {
	command -v node >/dev/null 2>&1 || {
		printf 'ERROR: node is required to verify managed Addy references\n' >&2
		return 1
	}

	node - "$HOME" "$addy_skills_ref" "${reference_files[@]}" <<'EOF_NODE'
const fs = require("node:fs");
const path = require("node:path");

const [homeArgument, expectedRef, ...referenceFiles] = process.argv.slice(2);
const markerName = ".addy-agent-skills-ref";
const managedMarkers = new Set([expectedRef, `pending:${expectedRef}`]);

function report(message) {
  process.stdout.write(`${message}\n`);
}

function fail(message) {
  process.stderr.write(`ERROR: ${message}\n`);
  process.exit(1);
}

function lstatOrNull(target) {
  try {
    return fs.lstatSync(target);
  } catch (error) {
    if (error.code === "ENOENT") return null;
    throw error;
  }
}

function main() {
try {
  const home = fs.realpathSync(homeArgument);
  const piRoot = path.join(home, ".pi");
  const agentRoot = path.join(piRoot, "agent");
  const referencesRoot = path.join(agentRoot, "references");

  for (const directory of [piRoot, agentRoot, referencesRoot]) {
    const stat = lstatOrNull(directory);
    if (!stat) {
      report("No managed Addy reference directory found.");
      return;
    }
    if (!stat.isDirectory() || stat.isSymbolicLink()) {
      fail(`refusing to clean through a non-directory or symlink: ${directory}`);
    }
  }

  const canonicalReferencesRoot = fs.realpathSync(referencesRoot);
  if (canonicalReferencesRoot !== referencesRoot) {
    fail(`refusing to clean outside the expected reference directory: ${canonicalReferencesRoot}`);
  }

  const markerPath = path.join(referencesRoot, markerName);
  const markerStat = lstatOrNull(markerPath);
  if (!markerStat) {
    report("No Addy reference ownership marker found; references were left unchanged.");
    return;
  }
  if (!markerStat.isFile() || markerStat.isSymbolicLink()) {
    fail(`refusing to read a non-regular ownership marker: ${markerPath}`);
  }

  const markerContent = fs.readFileSync(markerPath, "utf8");
  if (![...managedMarkers].some((value) => markerContent === value || markerContent === `${value}\n`)) {
    report("Unrecognized Addy reference ownership marker; references were left unchanged.");
    return;
  }

  let allManagedFilesRemoved = true;
  for (const name of referenceFiles) {
    const target = path.join(referencesRoot, name);
    const stat = lstatOrNull(target);
    if (!stat) continue;
    if (!stat.isFile() || stat.isSymbolicLink()) {
      report(`Preserving non-regular or symlinked reference: ${target}`);
      allManagedFilesRemoved = false;
      continue;
    }

    const canonicalTarget = fs.realpathSync(target);
    const relative = path.relative(canonicalReferencesRoot, canonicalTarget);
    if (!relative || relative === ".." || relative.startsWith(`..${path.sep}`) || path.isAbsolute(relative)) {
      fail(`refusing to remove a reference outside its managed root: ${canonicalTarget}`);
    }

    fs.unlinkSync(target);
    report(`Removed managed Addy reference: ${name}`);
  }

  if (allManagedFilesRemoved) {
    fs.unlinkSync(markerPath);
    report("Removed Addy reference ownership marker.");
  } else {
    report("Kept the ownership marker because some managed reference paths need inspection.");
  }
} catch (error) {
  fail(error instanceof Error ? error.message : String(error));
}
}

main();
EOF_NODE
}

case "${1:-}" in
remove)
	remove_addy_skills
	remove_addy_references
	;;
*)
	printf 'Usage: %s remove\n' "$0" >&2
	exit 2
	;;
esac
