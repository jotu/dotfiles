[env]
# Non-sensitive Obsidian CLI settings; resolve the vault path locally by name.
OBSIDIAN_VAULT = "base"
OBSIDIAN_ATOMIC_NOTES_DIR = "1 - Notes"
OBSIDIAN_ATOMIC_NOTE_TEMPLATE = "5 - Templates/Atomic Note.md"

{{ $personalIdentityFile := "" }}
{{ if and (hasKey . "personal") (hasKey .personal "ssh") (hasKey .personal.ssh "identityFile") }}
  {{ $personalIdentityFile = .personal.ssh.identityFile }}
{{ end }}
{{ $workUserIdentityFile := "" }}
{{ if and (hasKey . "work") (hasKey .work "ssh") (hasKey .work.ssh "user") (hasKey .work.ssh.user "identityFile") }}
  {{ $workUserIdentityFile = .work.ssh.user.identityFile }}
{{ end }}
{{ $workOrgIdentityFile := "" }}
{{ if and (hasKey . "work") (hasKey .work "ssh") (hasKey .work.ssh "organization") (hasKey .work.ssh.organization "identityFile") }}
  {{ $workOrgIdentityFile = .work.ssh.organization.identityFile }}
{{ end }}

[tasks."ssh:agent:restart"]
alias = "sar"
description = "Ensure the shared SSH agent and load configured identities"
run = '''
  set -eu

  add_if_exists() {
    if [ -f "$1" ]; then
      ssh-add "$1" >&2
    fi
  }

  if [ -n "${SSH_AUTH_SOCK:-}" ]; then
    agent_socket="$SSH_AUTH_SOCK"
  elif [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    agent_socket="$XDG_RUNTIME_DIR/ssh-agent.sock"
  else
    echo "ERROR: XDG_RUNTIME_DIR is unavailable; cannot locate the SSH agent socket" >&2
    exit 1
  fi

  if [ -S "$agent_socket" ]; then
    export SSH_AUTH_SOCK="$agent_socket"
    printf 'export SSH_AUTH_SOCK=%s\n' "$SSH_AUTH_SOCK"
  else
    agent_env=$(ssh-agent -a "$agent_socket" -s | sed '/^echo Agent pid/d')
    eval "$agent_env"
    printf '%s\n' "$agent_env"
  fi
{{- if and .work.enable $workUserIdentityFile }}
  add_if_exists "$HOME/.ssh/{{ $workUserIdentityFile }}"
{{- end }}
{{- if and .work.enable $workOrgIdentityFile }}
  add_if_exists "$HOME/.ssh/{{ $workOrgIdentityFile }}"
{{- end }}
{{- if $personalIdentityFile }}
  add_if_exists "$HOME/.ssh/{{ $personalIdentityFile }}"
{{- end }}
'''

{{- $ghConfigPersonal := "~/.config/gh-personal" -}}
{{- $ghConfigWork := "~/.config/gh-work" -}}
{{- if hasKey .github "configDir" -}}
{{- $ghConfig := get .github "configDir" -}}
{{- if hasKey $ghConfig "personal" -}}{{- $ghConfigPersonal = get $ghConfig "personal" -}}{{- end -}}
{{- if hasKey $ghConfig "work" -}}{{- $ghConfigWork = get $ghConfig "work" -}}{{- end -}}
{{- end }}

[tasks."dotfiles:health:check"]
alias = "dhc"
description = "Validate gh, ssh agent, and repo roots"
run = '''
  set -eu

  expand_path() {
    case "$1" in
      "~") printf "%s\n" "$HOME" ;;
      "~/"*) printf "%s/%s\n" "$HOME" "${1#"~/"}" ;;
      *) printf "%s\n" "$1" ;;
    esac
  }

  if ! command -v gh >/dev/null 2>&1; then
    echo "ERROR: gh not found in PATH"
    exit 1
  fi

  if ! command -v ssh-add >/dev/null 2>&1; then
    echo "ERROR: ssh-add not found in PATH"
    exit 1
  fi

  gh_status_cmd='gh auth status --hostname github.com'

  check_gh_login() {
    local config_dir="$1"
    local profile_name="$2"

    if ! GH_CONFIG_DIR="$config_dir" $gh_status_cmd >/dev/null 2>&1; then
      echo "ERROR: gh is not logged in for $profile_name profile (GH_CONFIG_DIR=$config_dir)"
      echo "Run: GH_CONFIG_DIR=\"$config_dir\" gh auth login --hostname github.com"

      if GH_CONFIG_DIR="$HOME/.config/gh" $gh_status_cmd >/dev/null 2>&1; then
        echo "Hint: you are logged into default ~/.config/gh, but this profile uses GH_CONFIG_DIR=$config_dir"
      fi

      exit 1
    fi
  }

{{- if .work.enable }}
  gh_personal_dir=$(expand_path "{{ $ghConfigPersonal }}")
  gh_work_dir=$(expand_path "{{ $ghConfigWork }}")

  check_gh_login "$gh_personal_dir" "personal"
  check_gh_login "$gh_work_dir" "work"
{{- else }}
  if ! $gh_status_cmd >/dev/null 2>&1; then
    echo "ERROR: gh is not logged in for default profile"
    echo "Run: gh auth login --hostname github.com"
    exit 1
  fi
{{- end }}

{{- if $personalIdentityFile }}
  personal_key_path="$HOME/.ssh/{{ $personalIdentityFile }}"
  if [ ! -f "$personal_key_path" ]; then
    echo "ERROR: required SSH key file is missing: $personal_key_path"
    exit 1
  fi
{{- else }}
  echo "ERROR: personal.ssh.identityFile is not configured in local chezmoi data"
  exit 1
{{- end }}

{{- if .work.enable }}
{{- if $workOrgIdentityFile }}
  org_key_path="$HOME/.ssh/{{ $workOrgIdentityFile }}"
  org_cert_path="$HOME/.ssh/{{ $workOrgIdentityFile }}-cert.pub"
  if [ ! -f "$org_key_path" ] && [ ! -f "$org_cert_path" ]; then
    echo "ERROR: expected work org key or certificate file"
    echo "Missing both: $org_key_path and $org_cert_path"
    exit 1
  fi
{{- else }}
  echo "ERROR: work.ssh.organization.identityFile is not configured in local chezmoi data"
  exit 1
{{- end }}
{{- end }}

  keys_output=$(ssh-add -l 2>&1 || true)
  if printf "%s" "$keys_output" | grep -q "Could not open a connection to your authentication agent"; then
    echo "ERROR: ssh-agent is not available in this shell session"
    echo "Run: eval \"$(ssh-agent -s)\""
    exit 1
  fi

  loaded_keys=$(printf "%s\n" "$keys_output" | grep -c "SHA256:" || true)
  if [ "$loaded_keys" -lt 1 ]; then
    echo "ERROR: ssh-agent has no loaded identities"
{{- if $personalIdentityFile }}
    echo "Run: ssh-add ~/.ssh/{{ $personalIdentityFile }}"
{{- else }}
    echo "Run: configure personal.ssh.identityFile in local chezmoi data, then rerun this task"
{{- end }}
{{- if and .work.enable $workOrgIdentityFile }}
    echo "Then: ssh-add ~/.ssh/{{ $workOrgIdentityFile }}"
    echo "If your org uses SSH certificates, also run: ssh-add ~/.ssh/{{ $workOrgIdentityFile }}-cert.pub"
{{- end }}
    exit 1
  fi

{{- if .work.enable }}
  work_root="{{ if hasKey .work.git "rootDir" }}{{ get .work.git "rootDir" }}{{ end }}"
  personal_root="{{ if hasKey .personal.git "rootDir" }}{{ get .personal.git "rootDir" }}{{ end }}"

  if [ -z "$work_root" ] || [ -z "$personal_root" ]; then
    echo "ERROR: work.git.rootDir and personal.git.rootDir must be set in local chezmoi data"
    exit 1
  fi

  work_root=$(expand_path "$work_root")
  personal_root=$(expand_path "$personal_root")

  if [ ! -d "$work_root" ]; then
    echo "ERROR: work root dir does not exist: $work_root"
    exit 1
  fi

  if [ ! -d "$personal_root" ]; then
    echo "ERROR: personal root dir does not exist: $personal_root"
    exit 1
  fi
{{- end }}

  echo "OK: dotfiles health checks passed"
 '''

[tasks."gh:auth:login:personal"]
alias = "ghlp"
description = "Login gh personal profile"
run = '''
  set -eu

  expand_path() {
    case "$1" in
      "~") printf "%s\n" "$HOME" ;;
      "~/"*) printf "%s/%s\n" "$HOME" "${1#"~/"}" ;;
      *) printf "%s\n" "$1" ;;
    esac
  }

  gh_personal_dir=$(expand_path "{{ $ghConfigPersonal }}")
  GH_CONFIG_DIR="$gh_personal_dir" gh auth login --hostname github.com --git-protocol https
'''

{{- if .work.enable }}
[tasks."gh:auth:login:work"]
alias = "ghlw"
description = "Login gh work profile"
run = '''
  set -eu

  expand_path() {
    case "$1" in
      "~") printf "%s\n" "$HOME" ;;
      "~/"*) printf "%s/%s\n" "$HOME" "${1#"~/"}" ;;
      *) printf "%s\n" "$1" ;;
    esac
  }

  gh_work_dir=$(expand_path "{{ $ghConfigWork }}")
  GH_CONFIG_DIR="$gh_work_dir" gh auth login --hostname github.com --git-protocol ssh
'''

[tasks."gh:auth:status:all"]
alias = "ghsa"
description = "Show gh auth status for personal and work profiles"
run = '''
  set -eu

  expand_path() {
    case "$1" in
      "~") printf "%s\n" "$HOME" ;;
      "~/"*) printf "%s/%s\n" "$HOME" "${1#"~/"}" ;;
      *) printf "%s\n" "$1" ;;
    esac
  }

  gh_personal_dir=$(expand_path "{{ $ghConfigPersonal }}")
  gh_work_dir=$(expand_path "{{ $ghConfigWork }}")

  echo "Personal profile ($gh_personal_dir):"
  GH_CONFIG_DIR="$gh_personal_dir" gh auth status --hostname github.com
  echo
  echo "Work profile ($gh_work_dir):"
  GH_CONFIG_DIR="$gh_work_dir" gh auth status --hostname github.com
'''
{{- end }}

[tasks."gh:dash:install"]
alias = "ghdi"
description = "Install or update the pinned gh-dash GitHub CLI extension"
run = '''
  set -eu

  if ! command -v gh >/dev/null 2>&1; then
    echo "Skipping gh-dash: gh is not installed" >&2
    exit 0
  fi

  installed_version=$(NO_COLOR=1 gh extension list 2>/dev/null | awk '$1 == "gh" && $2 == "dash" && $3 == "dlvhdr/gh-dash" { print $4; exit }')
  if [ "$installed_version" = "v4.25.2" ]; then
    exit 0
  fi

  if ! gh extension install dlvhdr/gh-dash --pin v4.25.2 --force; then
    echo "WARNING: gh-dash was not installed; log in to the active gh profile and run mise run ghdi" >&2
  fi
'''

[tasks."gh:enhance:install"]
description = "Install or update the gh-enhance GitHub CLI extension"
run = '''
  set -eu

  if ! command -v gh >/dev/null 2>&1; then
    echo "Skipping gh-enhance: gh is not installed" >&2
    exit 0
  fi

  if ! gh extension install dlvhdr/gh-enhance --force; then
    echo "WARNING: gh-enhance was not installed; log in to the active gh profile and run mise run gh:enhance:install" >&2
  fi
'''

[tasks."proton:mise:update"]
hide = true
description = "Update Proton CLI via mise hook"
run = "mise run proton:cli:update"

[tasks."pi:ponytail:update"]
alias = "ppu"
description = "Update the managed Ponytail Pi package"
run = "pi update npm:@dietrichgebert/ponytail"

[hooks]
postinstall = [
  { run = '''
    if command -v pi >/dev/null 2>&1; then
      pi install npm:@dietrichgebert/ponytail
    fi
  ''' },
  { task = "gh:dash:install" },
  { task = "gh:enhance:install" },
]

