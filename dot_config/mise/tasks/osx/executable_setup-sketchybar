#!/usr/bin/env bash
#MISE description="Start SketchyBar and JankyBorders and hide the native macOS menu bar."
#MISE alias="osb"
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  exit 0
fi

if ! command -v brew >/dev/null 2>&1; then
  printf '%s\n' 'Homebrew is not installed; install the managed macOS packages first.' >&2
  exit 0
fi

for service in sketchybar borders; do
  if ! brew list --formula "$service" >/dev/null 2>&1; then
    printf '%s\n' "$service is not installed; run chezmoi apply first." >&2
    exit 0
  fi
  brew services start "$service"
done

defaults write NSGlobalDomain _HIHideMenuBar -bool true
killall SystemUIServer >/dev/null 2>&1 || true

printf '%s\n' 'Started SketchyBar and JankyBorders.'
printf '%s\n' 'The native macOS menu bar is hidden.'
printf '%s\n' 'Manual step: grant AeroSpace and JankyBorders Accessibility permission in System Settings > Privacy & Security > Accessibility.'
