#!/usr/bin/env bash
#MISE description="Install the pinned Proton Pass CLI"
set -euo pipefail

# Pinned from Proton's stable manifest: https://proton.me/download/pass-cli/versions.json
version="2.3.3"
base_url="https://proton.me/download/pass-cli/$version"

case "$(uname -s):$(uname -m)" in
  Darwin:arm64)
    asset="pass-cli-macos-aarch64"
    expected_sha256="3281587ac9c50ae2f1604ba75e9d1d39b6debb221b65a6cc56f64d626ede3dbc"
    ;;
  Darwin:x86_64)
    asset="pass-cli-macos-x86_64"
    expected_sha256="275f6159f63d152ecdd9d4e2969ef515291619005e0d30ab762daee26081621c"
    ;;
  Linux:aarch64)
    asset="pass-cli-linux-aarch64"
    expected_sha256="9c3e85e10d3bb631ffe377f063d996b9cc9a545d30971bcedf5910e16d03542b"
    ;;
  Linux:x86_64)
    asset="pass-cli-linux-x86_64"
    expected_sha256="b5b49a8b3fd0af8830c0c1979f28ea0c90ccece73f59023a8bca8245d4b68da9"
    ;;
  *)
    printf 'Unsupported Proton Pass CLI platform: %s:%s\n' "$(uname -s)" "$(uname -m)" >&2
    exit 1
    ;;
esac

install_dir="${PROTON_PASS_CLI_INSTALL_DIR:-$HOME/.local/bin}"
temp_file=$(mktemp)
trap 'rm -f "$temp_file"' EXIT

curl --fail --silent --show-error --location --retry 3 \
  --proto '=https' --tlsv1.2 \
  --output "$temp_file" "$base_url/$asset"

if command -v sha256sum >/dev/null 2>&1; then
  actual_sha256=$(sha256sum "$temp_file" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  actual_sha256=$(shasum -a 256 "$temp_file" | awk '{print $1}')
else
  printf '%s\n' 'No SHA-256 verification tool found (sha256sum or shasum).' >&2
  exit 1
fi

if [[ "$actual_sha256" != "$expected_sha256" ]]; then
  printf 'SHA-256 verification failed for Proton Pass CLI %s\n' "$version" >&2
  printf 'Expected: %s\nGot:      %s\n' "$expected_sha256" "$actual_sha256" >&2
  exit 1
fi

mkdir -p "$install_dir"
install -m 0755 "$temp_file" "$install_dir/pass-cli"
printf 'Installed Proton Pass CLI %s at %s/pass-cli\n' "$version" "$install_dir"
