{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

brew bundle --file=/dev/stdin <<EOF
brew "curl"
brew "git"
brew "gnupg"
brew "mise"
brew "openssl@3"
brew "p7zip"
brew "pinentry"
brew "pinentry-mac"
tap "nikitabobko/tap", trusted: true
cask "aerospace"
cask "font-fira-code-nerd-font"
cask "obsidian"
brew "tree"
brew "wget"
brew "zsh-autosuggestions"
brew "zsh-completions"
brew "zsh-syntax-highlighting"
EOF
{{ end -}}
