#general
alias f="z"
alias ll="ls -al"

# Common developer tools. Optional commands are only aliased when installed.
if command -v herdr >/dev/null 2>&1; then
  alias hr='herdr'
fi
if command -v chezmoi >/dev/null 2>&1; then
  alias cm='chezmoi'
fi
if command -v kubectl >/dev/null 2>&1; then
  alias k='kubectl'
  alias kgp='kubectl get pods'
  alias kgn='kubectl get nodes'
  alias klf='kubectl logs -f'
  alias kex='kubectl exec -it'
fi
if command -v k9s >/dev/null 2>&1; then
  alias k9='k9s'
fi
if command -v lazygit >/dev/null 2>&1; then
  alias lg='lazygit'
fi
if command -v hunk >/dev/null 2>&1; then
  alias hkd='hunk diff'
  alias hks='hunk diff --staged'
fi
if command -v docker >/dev/null 2>&1; then
  alias dc='docker compose'
fi
if command -v gofmt >/dev/null 2>&1; then
  alias gof='gofmt -w'
fi
if command -v golangci-lint >/dev/null 2>&1; then
  alias gol='golangci-lint run'
fi
if command -v shellcheck >/dev/null 2>&1; then
  alias shc='shellcheck'
fi
if command -v shfmt >/dev/null 2>&1; then
  alias shf='shfmt -w'
fi
if command -v shellspec >/dev/null 2>&1; then
  alias sht='shellspec'
fi

# sk (https://github.com/erikkinding/sk)
alias skp="sk -p" # Previously selected context and namespace
alias skn="sk -n" # Also prompt for namespace selection
alias skN="sk -N" # Only prompt for namespace selection
alias skc="sk -c" # Print the currently selected context and namespace
alias ghlp='mise run gh:auth:login:personal'
alias opos='mise run opencode:config:current'
{{- if .work.enable }}
alias kinit="kinit --keychain {{ .work.employee.code }}@{{ .work.domain.name }}"
alias goedemorgen='if command -v open >/dev/null; then open -a "Firefox" "{{ .work.saml.auth.url }}?nocache=$(date +%s)"; fi; if command -v mise >/dev/null; then mise tb:aws:login; fi'
alias ghlw='mise run gh:auth:login:work'
alias ghsa='mise run gh:auth:status:all'
{{- end }}
