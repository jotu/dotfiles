# Zsh-only additions. Shared aliases and functions live in
# ~/.config/shell/aliases so Bash and Zsh use the same command names.
if command -v aerospace >/dev/null 2>&1; then
  alias ae='aerospace'
  compdef ae=aerospace
fi

if [ -r "$HOME/.config/shell/aliases" ]; then
  source "$HOME/.config/shell/aliases"
fi
