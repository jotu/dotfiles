{{- $provider := "github-copilot" -}}
{{- $model := "gpt-5.6-luna" -}}
{{- $thinkingLevel := "high" -}}
{{- if .work.enable -}}
  {{- $provider = "openai-codex" -}}
  {{- $model = "gpt-6-luna" -}}
  {{- $thinkingLevel = "xhigh" -}}
{{- end -}}
{
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail@4.8.3",
      "extensions": []
    }{{ if .work.enable }},
    {
      "source": "npm:pi-chatgpt-limit@0.3.1"
    }{{ end }},
    {
      "source": "npm:pi-mcp-adapter@3.2.0"
    }
  ],
  "npmCommand": [
{{- if eq .chezmoi.os "darwin" }}
    "mise",
    "exec",
    "node@22.22.2",
    "--",
{{- end }}
    "npm"
  ],
  "defaultProvider": "{{ $provider }}",
  "defaultModel": "{{ $model }}",
  "defaultThinkingLevel": "{{ $thinkingLevel }}",
  "enabledModels": [
    "{{ $provider }}/{{ $model }}"
  ],
  "theme": "{{ if eq .chezmoi.os "linux" }}omarchy-system{{ else }}catppuccin-macchiato{{ end }}",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "defaultProjectTrust": "ask"
}
