{{- if eq .chezmoi.os "linux" }}
# Keep Omarchy's environment defaults without sourcing its Bash-only rc.
if [[ -r /usr/share/omarchy/default/bash/envs ]]; then
  source /usr/share/omarchy/default/bash/envs
fi
{{- end }}

{{ if eq .chezmoi.os "darwin" }}
export BREW_HOME="/opt/homebrew"
{{ end }}

{{- $githubUsername := "" -}}
{{- if .work.enable -}}
{{- if and (hasKey . "github") (hasKey .github "workUsername") -}}
{{- $githubUsername = get .github "workUsername" -}}
{{- else if and (hasKey . "work") (hasKey .work "git") (hasKey .work.git "username") -}}
{{- $githubUsername = get .work.git "username" -}}
{{- else if and (hasKey . "github") (hasKey .github "username") -}}
{{- $githubUsername = get .github "username" -}}
{{- end -}}
{{- else if and (hasKey . "github") (hasKey .github "username") -}}
{{- $githubUsername = get .github "username" -}}
{{- else if and (hasKey . "personal") (hasKey .personal "git") (hasKey .personal.git "username") -}}
{{- $githubUsername = get .personal.git "username" -}}
{{- end -}}
{{- $ghTokenConfigDir := "" -}}
{{- if .work.enable -}}
{{- $ghTokenConfigDir = "~/.config/gh-work" -}}
{{- if and (hasKey . "github") (hasKey .github "configDir") -}}
{{- $ghConfig := get .github "configDir" -}}
{{- if hasKey $ghConfig "work" -}}{{- $ghTokenConfigDir = get $ghConfig "work" -}}{{- end -}}
{{- end -}}
{{- end -}}

# openssl
if [[ -n "${BREW_HOME:-}" ]]; then
  export LDFLAGS="-L$BREW_HOME/opt/openssl@3/lib"
  export CPPFLAGS="-I$BREW_HOME/opt/openssl@3/include"
  export PATH="$BREW_HOME/opt/openssl@3/bin:$PATH"
fi

# GITHUB
# Mise needs an API token in GITHUB_TOKEN; gh/git credential helpers do not export one.
# Respect an explicitly selected profile, otherwise use the work profile on work
# machines and the default gh profile on personal machines.
if [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]] && command -v gh >/dev/null 2>&1; then
  if [[ -n "${GH_CONFIG_DIR:-}" ]]; then
    _mise_github_token=$(gh auth token 2>/dev/null || true)
  elif [[ -n "{{ $ghTokenConfigDir }}" ]]; then
    _gh_config_dir="{{ $ghTokenConfigDir }}"
    case "$_gh_config_dir" in
      "~") _gh_config_dir="$HOME" ;;
      "~/"*) _gh_config_dir="$HOME/${_gh_config_dir#~/}" ;;
    esac
    _mise_github_token=$(GH_CONFIG_DIR="$_gh_config_dir" gh auth token 2>/dev/null || true)
    unset _gh_config_dir
  else
    _mise_github_token=$(gh auth token 2>/dev/null || true)
  fi
  if [[ -n "$_mise_github_token" ]]; then
    export GITHUB_TOKEN="$_mise_github_token"
  fi
  unset _mise_github_token
fi
{{- if ne $githubUsername "" }}
if [[ -z "${GITHUB_TOKEN:-}" && -z "${GH_TOKEN:-}" ]] && command -v security >/dev/null 2>&1; then
  _mise_github_token=$(security find-generic-password -s "github" -a {{ $githubUsername | quote }} -w 2>/dev/null || true)
  if [[ -n "$_mise_github_token" ]]; then
    export GITHUB_TOKEN="$_mise_github_token"
  fi
  unset _mise_github_token
fi
{{- end }}

