{{- $provider := "github-copilot" -}}
{{- $model := "claude-sonnet-5.5" -}}
{{- $thinkingLevel := "medium" -}}
{{- if .work.enable -}}
  {{- $provider = "openai-codex" -}}
  {{- $model = "gpt-6.1-terra" -}}
  {{- $thinkingLevel = "medium" -}}
{{- end -}}
{{- $sharedSkills := list
  "ask-matt"
  "code-review"
  "codebase-design"
  "diagnosing-bugs"
  "domain-modeling"
  "grill-me"
  "grill-with-docs"
  "grilling"
  "handoff"
  "implement"
  "improve-codebase-architecture"
  "setup-matt-pocock-skills"
  "tdd"
  "teach"
  "to-tickets"
  "triage"
  "wait-what"
  "wayfinder"
  "wizard"
-}}
{{- $skillExclusions := list -}}
{{- range $skill := $sharedSkills -}}
  {{- if stat (joinPath $.chezmoi.homeDir ".agents" "skills" $skill "SKILL.md") -}}
    {{- $skillExclusions = append $skillExclusions (printf "-%s" (joinPath $.chezmoi.homeDir ".pi" "agent" "skills" $skill)) -}}
  {{- end -}}
{{- end -}}
{
  "packages": [
{{- if .work.enable }}
    {
      "source": "npm:pi-chatgpt-limit@0.3.1"
    },
{{- else }}
    {
      "source": "npm:pi-copilot-usage@1.0.0"
    },
{{- end }}
    {
      "source": "npm:pi-mcp-adapter@3.2.0"
    }
  ],
  "npmCommand": [
{{- if eq .chezmoi.os "darwin" }}
    "mise",
    "exec",
    "node@22.22.2",
    "--",
{{- end }}
    "npm"
  ],
  "defaultProvider": "{{ $provider }}",
  "defaultModel": "{{ $model }}",
  "defaultThinkingLevel": "{{ $thinkingLevel }}",
  "enabledModels": [
    "{{ $provider }}/{{ $model }}"
  ],
  "skills": {{/* Pi discovers ~/.agents/skills too. Exclude native copies only when the shared copy exists. */}}{{ toPrettyJson $skillExclusions | trimSuffix "\n" | replace "\n" "\n  " }},
  "theme": "{{ if eq .chezmoi.os "linux" }}omarchy-system{{ else }}catppuccin-macchiato{{ end }}",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "defaultProjectTrust": "ask",
  "quietStartup": "header",
  "hideThinkingBlock": true
}
