{{- if .work.enable }}
{{- $workOrgIdentityFile := "" -}}
{{- if and (hasKey . "work") (hasKey .work "ssh") (hasKey .work.ssh "organization") (hasKey .work.ssh.organization "identityFile") -}}
  {{- $workOrgIdentityFile = .work.ssh.organization.identityFile -}}
{{- end -}}
{{- $ghConfigWork := "~/.config/gh-work" -}}
{{- if hasKey .github "configDir" -}}
{{- $ghConfig := get .github "configDir" -}}
{{- if hasKey $ghConfig "work" -}}{{- $ghConfigWork = get $ghConfig "work" -}}{{- end -}}
{{- end }}

[user]
    name = {{ .name | quote }}
    email = {{ .work.git.email | quote }}
    signingkey = {{ .work.git.signingKey | quote }}

[credential "https://github.com"]
        helper = !GH_CONFIG_DIR={{ $ghConfigWork }} gh auth git-credential

[credential "https://gist.github.com"]
        helper = !GH_CONFIG_DIR={{ $ghConfigWork }} gh auth git-credential

[url "ssh://git@github.com/"]
        insteadOf = https://github.com/

{{- if $workOrgIdentityFile }}
[core]
        sshCommand = ssh -F /dev/null -i ~/.ssh/{{ $workOrgIdentityFile }} -o IdentitiesOnly=yes
{{- end }}

[commit]
        gpgsign = true

[filter "lfs"]
        clean = git-lfs clean -- %f
        smudge = git-lfs smudge -- %f
        process = git-lfs filter-process
        required = true
[gpg]
        program = gpg
{{- end }}
